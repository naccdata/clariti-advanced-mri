      "description": "Laundch gears on all MEGRE QSM scans."
    },
     "do_qsmxt": {
      "type": "boolean",
      "default": true,
      "description": "Toggle this option on to select lauching of QSMxT gear."
    },
     "do_qsm_medi": {
      "type": "boolean",
      "default": true,
      "description": "Toggle this option on to select launching of QSM-MEDI gear."
    }
  },
  "inputs": {
    "api-key": {
      "base": "api-key",
      "read-only": false
    }
  },
  "command": "python3 /flywheel/v0/run.py"
}